{
  "manifest_version": 3,
  "name": "Umbraco Helper",
  "version": "1.1.0",
  "description": "Hide, button-toggle, or show tooltips / help text on Umbraco backoffice pages, plus handy keyboard and UI tweaks.",
  "permissions": ["storage", "activeTab"],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Umbraco Helper",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["*://*/umbraco*"],
      "js": ["defaults.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
